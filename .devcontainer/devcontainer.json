{
  "name": "dna-article",
  "image": "dna-article:ubuntu26.04",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "root",
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "source /opt/conda/etc/profile.d/conda.sh && nohup /opt/conda/envs/plots/bin/jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root --notebook-dir=/workspace --ServerApp.token=dna --ServerApp.password='' > /tmp/jupyterlab.log 2>&1 &",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/plots/bin/python"
      }
    }
  }
}
